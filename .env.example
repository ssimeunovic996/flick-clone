# Kopiraj u .env i upiši svoje vrednosti. .env se ne čuva u git-u.
COMFYUI_URL=http://127.0.0.1:8188

# Glas: ElevenLabs direktno ili servis koji ga prodaje preko svog API-ja (ai33).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Za ai33: ELEVENLABS_BASE_URL=https://api.ai33.pro (pipeline sam koristi njihov v3 API i proveru posla).
# Glas iz ai33 spiska: python -m pipeline.gen_voice glasovi [pretraga]
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# Drugi servisi koji vraćaju id posla umesto zvuka: adresa za proveru posla, sa {task_id}
# ELEVENLABS_TASK_URL=https://<servis>/v1/task/{task_id}
# Ako servis traži drugo zaglavlje za ključ (podrazumevano xi-api-key)
# ELEVENLABS_AUTH_HEADER=xi-api-key
